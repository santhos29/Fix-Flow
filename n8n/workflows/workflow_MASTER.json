    {
      "parameters": {
        "jsCode": "const issue = $input.first().json;\nconst matches = issue.kb_matches || [];\n\nlet tipsText = 'Similar resolved issues found \u2014 review before investigating:\\n\\n';\nmatches.forEach((m, i) => {\n  tipsText += `Option ${i+1} (${(m.similarity * 100).toFixed(0)}% match):\\n${m.fix_steps}\\n\\n`;\n});\n\nreturn [{ json: { ...issue, tips_text: tipsText, best_assignee: matches[0]?.assigned_to || 'unassigned' } }];"
      },
