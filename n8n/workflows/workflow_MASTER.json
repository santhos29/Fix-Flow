{
  "name": "FixFlow \u2014 MASTER (Connected)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fixflow/intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-intake",
      "name": "Webhook Intake",
      "type": "n8n-nodes-base.webhook",
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize intake payload from any source (webhook / form / email)\nconst body = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    title: body.title || body.subject || 'Untitled Issue',\n    description: body.description || body.body || body.text || '',\n    source: body.source || 'webhook',\n    reporter_email: body.reporter || body.email || '',\n    tags: body.tags || [],\n    raw_payload: body\n  }\n}];"
      },
      "id": "normalize-payload",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"models/gemini-embedding-001\",\n  \"content\": {\n    \"parts\": [{\n      \"text\": \"={{ $json.title + ': ' + $json.description }}\"\n    }]\n  },\n  \"output_dimensionality\": 1536\n}"
      },
      "id": "embed-description",
      "name": "Embed Issue (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/match_issues",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query_embedding\": {{ $json.embedding.values }},\n  \"match_threshold\": 0.0,\n  \"match_count\": 3\n}"
      },
      "id": "vector-search",
      "name": "Vector Search (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Determine agent type based on top similarity score\nconst results = $input.first().json;\nconst topScore = results.length > 0 ? results[0].similarity : 0;\nconst issue = $('Normalize Payload').first().json;\nconst embedding = $('Embed Issue (Gemini)').first().json.embedding.values;\n\nlet agentType;\nif (topScore >= 0.85) agentType = 'known';\nelse if (topScore >= 0.65) agentType = 'mid';\nelse agentType = 'unknown';\n\nreturn [{\n  json: {\n    ...issue,\n    embedding,\n    agent_type: agentType,\n    similarity_score: topScore,\n    kb_matches: results\n  }\n}];"
      },
      "id": "classify",
      "name": "Classify Agent Type",
      "type": "n8n-nodes-base.code",
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/issues",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $json.title }}\",\n  \"description\": \"{{ $json.description }}\",\n  \"source\": \"{{ $json.source }}\",\n  \"agent_type\": \"{{ $json.agent_type }}\",\n  \"similarity_score\": {{ $json.similarity_score }},\n  \"tags\": {{ JSON.stringify($json.tags) }},\n  \"raw_payload\": {{ JSON.stringify($json.raw_payload) }}\n}"
      },
      "id": "log-issue",
      "name": "Log Issue to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1300,
        300
      ]
