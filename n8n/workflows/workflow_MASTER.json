        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"body\": {\n    \"type\": \"doc\", \"version\": 1,\n    \"content\": [\n      { \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"\ud83e\udd16 FixFlow Auto-Resolution:\", \"marks\": [{\"type\": \"strong\"}] }] },\n      { \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"Confidence Score: {{ $json.similarity_score.toFixed(2) }}\" }] },\n      { \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"{{ $json.fix_steps }}\" }] }\n    ]\n  }\n}"
      },
