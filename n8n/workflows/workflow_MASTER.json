        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"project\": { \"key\": \"{{ $env.JIRA_PROJECT_KEY }}\" },\n    \"summary\": \"[KNOWN] {{ $json.title }}\",\n    \"description\": {\n      \"type\": \"doc\", \"version\": 1,\n      \"content\": [{ \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"{{ $json.description }}\" }] }]\n    },\n    \"issuetype\": { \"name\": \"Bug\" },\n    \"priority\": { \"name\": \"Medium\" },\n    \"labels\": [\"auto-managed\", \"known-issue\", \"agent-resolved\"],\n    \"customfield_10050\": \"known\",\n    \"customfield_10051\": {{ $json.similarity_score }}\n  }\n}"
      },
      "id": "jira-create",
      "name": "Jira: Create Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        420,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const issue = $('Input from Classifier').first().json;\nconst jiraResponse = $input.first().json;\nconst ticketId = jiraResponse.key;\nconst ticketUrl = `${$env.JIRA_BASE_URL}/browse/${ticketId}`;\nconst kb = issue.kb_matches[0];\n\nreturn [{\n  json: {\n    ...issue,\n    jira_ticket_id: ticketId,\n    jira_ticket_url: ticketUrl,\n    fix_steps: kb.fix_steps,\n    kb_assigned_to: kb.assigned_to\n  }\n}];"
      },
      "id": "extract-ticket-id",
      "name": "Extract Ticket ID",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        500
