{
  "name": "FixFlow — B: Known Issue Agent",
  "_description": "Handles issues with similarity >= 0.85. Creates Jira ticket, posts solution, assigns, moves to In Progress.",
  "nodes": [
    {
      "id": "input",
      "name": "Input from Classifier",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [200, 300],
      "_note": "Replace with 'Execute Workflow Trigger' when called from Workflow A"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JIRA_BASE_URL }}/rest/api/3/issue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Basic {{ Buffer.from($env.JIRA_EMAIL + ':' + $env.JIRA_API_TOKEN).toString('base64') }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"project\": { \"key\": \"{{ $env.JIRA_PROJECT_KEY }}\" },\n    \"summary\": \"[KNOWN] {{ $json.title }}\",\n    \"description\": {\n      \"type\": \"doc\", \"version\": 1,\n      \"content\": [{ \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"{{ $json.description }}\" }] }]\n    },\n    \"issuetype\": { \"name\": \"Bug\" },\n    \"priority\": { \"name\": \"Medium\" },\n    \"labels\": [\"auto-managed\", \"known-issue\", \"agent-resolved\"],\n    \"customfield_10050\": \"known\",\n    \"customfield_10051\": {{ $json.similarity_score }}\n  }\n}"
      },
      "id": "jira-create",
      "name": "Jira: Create Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const issue = $('Input from Classifier').first().json;\nconst jiraResponse = $input.first().json;\nconst ticketId = jiraResponse.key;\nconst ticketUrl = `${$env.JIRA_BASE_URL}/browse/${ticketId}`;\nconst kb = issue.kb_matches[0];\n\nreturn [{\n  json: {\n    ...issue,\n    jira_ticket_id: ticketId,\n    jira_ticket_url: ticketUrl,\n    fix_steps: kb.fix_steps,\n    kb_assigned_to: kb.assigned_to\n  }\n}];"
      },
      "id": "extract-ticket-id",
      "name": "Extract Ticket ID",
      "type": "n8n-nodes-base.code",
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JIRA_BASE_URL }}/rest/api/3/issue/{{ $json.jira_ticket_id }}/comment",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Basic {{ Buffer.from($env.JIRA_EMAIL + ':' + $env.JIRA_API_TOKEN).toString('base64') }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"body\": {\n    \"type\": \"doc\", \"version\": 1,\n    \"content\": [\n      { \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"🤖 FixFlow Auto-Resolution:\", \"marks\": [{\"type\": \"strong\"}] }] },\n      { \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"Confidence Score: {{ $json.similarity_score.toFixed(2) }}\" }] },\n      { \"type\": \"paragraph\", \"content\": [{ \"type\": \"text\", \"text\": \"{{ $json.fix_steps }}\" }] }\n    ]\n  }\n}"
      },
      "id": "jira-comment",
      "name": "Jira: Post Solution Comment",
      "type": "n8n-nodes-base.httpRequest",
      "position": [860, 300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.JIRA_BASE_URL }}/rest/api/3/issue/{{ $json.jira_ticket_id }}/assignee",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Basic {{ Buffer.from($env.JIRA_EMAIL + ':' + $env.JIRA_API_TOKEN).toString('base64') }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"accountId\": \"{{ $json.kb_assigned_to }}\" }"
      },
      "id": "jira-assign",
      "name": "Jira: Assign Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JIRA_BASE_URL }}/rest/api/3/issue/{{ $json.jira_ticket_id }}/transitions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Basic {{ Buffer.from($env.JIRA_EMAIL + ':' + $env.JIRA_API_TOKEN).toString('base64') }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"transition\": { \"id\": \"21\" } }",
        "_note": "Transition ID '21' = In Progress. Get yours via GET /rest/api/3/issue/{id}/transitions"
      },
      "id": "jira-in-progress",
      "name": "Jira: Move to In Progress",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/issues?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jira_ticket_id\": \"{{ $json.jira_ticket_id }}\",\n  \"jira_ticket_url\": \"{{ $json.jira_ticket_url }}\",\n  \"status\": \"in_progress\",\n  \"assigned_to\": \"{{ $json.kb_assigned_to }}\"\n}"
      },
      "id": "supabase-update",
      "name": "Supabase: Update Issue Status",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1520, 300]
    }
  ],
  "connections": {
    "Input from Classifier": { "main": [[{ "node": "Jira: Create Ticket" }]] },
    "Jira: Create Ticket": { "main": [[{ "node": "Extract Ticket ID" }]] },
    "Extract Ticket ID": { "main": [[{ "node": "Jira: Post Solution Comment" }]] },
    "Jira: Post Solution Comment": { "main": [[{ "node": "Jira: Assign Ticket" }]] },
    "Jira: Assign Ticket": { "main": [[{ "node": "Jira: Move to In Progress" }]] },
    "Jira: Move to In Progress": { "main": [[{ "node": "Supabase: Update Issue Status" }]] }
  }
}
